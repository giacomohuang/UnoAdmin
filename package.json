{
  "name": "unoadmin",
  "version": "1.0.0",
  "private": true,
  "description": "UnoAdmin modular Vue 3 administration workspace",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @unoadmin/admin-app dev",
    "build": "pnpm --filter @unoadmin/admin-app build",
    "typecheck": "pnpm --filter @unoadmin/admin-app type-check",
    "test": "pnpm --filter @unoadmin/admin-app test:unit",
    "lint": "pnpm --filter @unoadmin/admin-app lint",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.25.0",
      "onFail": "download"
    }
  }
}
