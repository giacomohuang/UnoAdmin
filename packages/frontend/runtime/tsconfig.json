{
  "compilerOptions": {
    // Runtime is typed as a Vue package while keeping compilation emit-free.
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve"
  },
  "include": ["src/**/*.ts"]
}
