# HTTP / gRPC 监听地址
HTTP_ADDR=:8080
GRPC_ADDR=:9090

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=unoadmin

# JWT 访问令牌（不携带权限，权限每次从数据库加载）
JWT_SECRET=change-me-in-production
TOKEN_TTL_SECONDS=3600

# Redis 刷新令牌
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=10
REFRESH_TTL_SECONDS=604800

# 服务间调用
GRPC_SERVICE_TOKEN=change-me-service-token

# 其它
BCRYPT_COST=10
# 本地跨域调试可设为 *；生产环境必须列出明确的前端来源。
ALLOWED_ORIGINS=http://localhost:5173
SEED_PASSWORD=admin123
